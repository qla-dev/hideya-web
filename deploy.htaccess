Options -Indexes
DirectoryIndex index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Served from dist/hideya/web/dist as https://qla.dev/hideya, so match files
  # relative to this directory, not DOCUMENT_ROOT.
  # /play without the slash: redirect here, before mod_dir adds the slash
  # itself from the internal dist/ path. The second rule repairs that bad URL
  # for browsers that cached it.
  RewriteRule ^play$ /hideya/play/ [R=301,L]
  RewriteRule ^play/dist/ /hideya/play/ [R=301,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
  # The browser app (dist/play): any other route inside it opens the app.
  # Files (with an extension) are left alone: the -f check above misses
  # pnpm asset paths with + and @, which then load as plain files.
  RewriteRule ^play(/[^.]*)?$ play/index.html [L]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
